rules_version = '2';
// SUNNY 班級聯絡本 — 【過渡期】規則：新版已上鎖，舊版家長暫時還能看（不能寫）
// 貼到 Firebase 後台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // 只有 SUNNY 的 Google 帳號算老師
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "sunnymath30@gmail.com"
          && request.auth.token.email_verified == true;
    }
    function isDate(id) { return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // 班級設定（各班鑰匙）：只有老師讀寫
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // books/{班級鑰匙}/...：知道鑰匙才找得到；不能列出有哪些鑰匙
    match /books/{key} {
      allow read, write: if isAdmin();

      match /meta/{doc} {
        allow get: if key.size() >= 20;
        allow list: if false;
        allow write: if isAdmin();
      }
      match /entries/{date} {
        allow get, list: if key.size() >= 20;
        allow write: if isAdmin()
          && isDate(date)
          && (request.method == 'delete' || (
                request.resource.data.keys().hasOnly(['date','text','hasImg','updatedAt'])
             && request.resource.data.date == date
             && request.resource.data.text is string
             && request.resource.data.text.size() <= 2000
             && request.resource.data.hasImg is bool));
      }
      match /imgs/{date} {
        allow get: if key.size() >= 20;
        allow list: if isAdmin();
        allow write: if isAdmin()
          && isDate(date)
          && (request.method == 'delete' || (
                request.resource.data.keys().hasOnly(['img'])
             && request.resource.data.img is string
             && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,.*')));
      }
    }

    // 舊版資料：搬完後只留老師讀得到的備份，任何人都不能寫
    match /lianluoben/{doc}     { allow read: if true; allow write: if false; }   // 過渡期：舊網頁家長還能看
    match /lianluoben_img/{doc} { allow read: if true; allow write: if false; }

    // 其他一律拒絕
    match /{document=**} { allow read, write: if false; }
  }
}
